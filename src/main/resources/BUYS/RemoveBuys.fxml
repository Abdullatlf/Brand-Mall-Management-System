<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.BuysController">
    <children>
        <Label layoutX="64.0" layoutY="14.0" text="Remove Purchase Operation">
            <font>
                <Font name="Al Bayan Bold" size="36.0" />
            </font>
        </Label>

        <!-- TableView with Columns -->
        <TableView fx:id="buysTableView" layoutX="64.0" layoutY="87.0" prefHeight="250.0" prefWidth="472.0">
            <columns>
                <TableColumn fx:id="invoiceColumn" prefWidth="120.0" text="Invoice" />
                <TableColumn fx:id="customerSsnColumn" prefWidth="180.0" text="Customer SSN" />
                <TableColumn fx:id="productIdColumn" prefWidth="170.0" text="Product ID" />
            </columns>
        </TableView>

        <Button layoutX="450.0" layoutY="347.0" mnemonicParsing="false" onAction="#refreshTable" text="Refresh">
            <font>
                <Font size="14.0" />
            </font>
        </Button>

        <Label layoutX="102.0" layoutY="390.0" text="Invoice : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <TextField fx:id="invoiceTextField" layoutX="234.0" layoutY="392.0" />

        <Button layoutX="236.0" layoutY="434.0" mnemonicParsing="false" onAction="#remove" text="Remove Purchase" style="-fx-background-color: #d32f2f; -fx-text-fill: white;">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Button>

        <Label fx:id="successLabel" alignment="CENTER" layoutX="-4.0" layoutY="484.0" prefHeight="23.0" prefWidth="600.0" textAlignment="JUSTIFY">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Button layoutX="14.0" layoutY="540.0" mnemonicParsing="false" onAction="#backToBuys" text="&lt;----">
            <font>
                <Font size="24.0" />
            </font>
        </Button>
    </children>
</AnchorPane>