<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MallController">
    <children>
        <Label layoutX="100.0" layoutY="14.0" text="Search Mall Operation">
            <font>
                <Font name="Al Bayan Bold" size="36.0" />
            </font>
        </Label>
        <Label layoutX="135.0" layoutY="171.0" text="Mall ID : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <TextField fx:id="idTextField" layoutX="234.0" layoutY="173.0" />
        <Button fx:id="button" layoutX="251.0" layoutY="215.0" mnemonicParsing="false" onAction="#search" text="Find Mall">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Button>
        <Label fx:id="successLabel" alignment="CENTER" layoutX="15.0" layoutY="263.0" prefHeight="23.0" prefWidth="600.0" textAlignment="JUSTIFY">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Button layoutX="14.0" layoutY="441.0" mnemonicParsing="false" onAction="#backToMall" text="&lt;----">
            <font>
                <Font size="24.0" />
            </font>
        </Button>
        <Label fx:id="searchLabel" alignment="CENTER" layoutX="8.0" layoutY="88.0" prefHeight="74.0" prefWidth="600.0" textAlignment="CENTER">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
    </children>
</AnchorPane>