<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ManagerController">
    <children>
        <Label layoutX="64.0" layoutY="14.0" text="Remove Manager Operation">
            <font>
                <Font name="Al Bayan Bold" size="36.0" />
            </font>
        </Label>

        <!-- TableView with Columns -->
        <TableView fx:id="managerTableView" layoutX="64.0" layoutY="87.0" prefHeight="250.0" prefWidth="472.0">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="120.0" text="Manager ID" />
                <TableColumn fx:id="nameColumn" prefWidth="200.0" text="Name" />
                <TableColumn fx:id="phoneColumn" prefWidth="150.0" text="Phone" />
            </columns>
        </TableView>

        <Button layoutX="450.0" layoutY="347.0" mnemonicParsing="false" onAction="#refreshTable" text="Refresh">
            <font>
                <Font size="14.0" />
            </font>
        </Button>

        <Label layoutX="102.0" layoutY="390.0" text="Manager ID : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <TextField fx:id="idTextField" layoutX="234.0" layoutY="392.0" />

        <Button layoutX="236.0" layoutY="434.0" mnemonicParsing="false" onAction="#remove" text="Remove Manager" style="-fx-background-color: #d32f2f; -fx-text-fill: white;">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Button>

        <Label fx:id="successLabel" alignment="CENTER" layoutX="-4.0" layoutY="484.0" prefHeight="23.0" prefWidth="600.0" textAlignment="JUSTIFY">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Button layoutX="14.0" layoutY="540.0" mnemonicParsing="false" onAction="#backToManager" text="&lt;----">
            <font>
                <Font size="24.0" />
            </font>
        </Button>
    </children>
</AnchorPane>