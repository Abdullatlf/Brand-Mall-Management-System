<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.BrandController">
    <children>
        <Label layoutX="90.0" layoutY="14.0" text="Remove Brand Operation">
            <font>
                <Font name="Al Bayan Bold" size="36.0" />
            </font>
        </Label>
        <Label layoutX="102.0" layoutY="299.0" text="Brand ID : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <TextField fx:id="idTextField" layoutX="234.0" layoutY="301.0" />
        <Button fx:id="button" layoutX="253.0" layoutY="343.0" mnemonicParsing="false" onAction="#remove" text="Remove Brand">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Button>
        <Label fx:id="successLabel" alignment="CENTER" layoutX="-4.0" layoutY="393.0" prefHeight="23.0" prefWidth="600.0" textAlignment="JUSTIFY">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Button layoutX="14.0" layoutY="441.0" mnemonicParsing="false" onAction="#backToBrand" text="&lt;----">
            <font>
                <Font size="24.0" />
            </font>
        </Button>
        <ListView fx:id="brandListView" layoutX="64.0" layoutY="87.0" prefHeight="200.0" prefWidth="472.0" />
    </children>
</AnchorPane>