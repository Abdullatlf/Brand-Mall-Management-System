<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.BrandController">
    <children>
        <Label layoutX="90.0" layoutY="14.0" text="Update Brand Operation">
            <font>
                <Font name="Al Bayan Bold" size="36.0" />
            </font>
        </Label>

        <TableView fx:id="brandTableView" layoutX="64.0" layoutY="87.0" prefHeight="200.0" prefWidth="472.0">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="200.0" text="Brand ID" />
                <TableColumn fx:id="nameColumn" prefWidth="270.0" text="Name" />
            </columns>
        </TableView>

        <Button layoutX="450.0" layoutY="297.0" mnemonicParsing="false" onAction="#refreshTable" text="Refresh">
            <font>
                <Font size="14.0" />
            </font>
        </Button>

        <Label layoutX="102.0" layoutY="340.0" text="Brand ID : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <TextField fx:id="idTextField" layoutX="234.0" layoutY="342.0" />

        <Label layoutX="103.0" layoutY="380.0" text="Name       : " textAlignment="CENTER">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <TextField fx:id="nameTextField" layoutX="234.0" layoutY="382.0" />

        <Button layoutX="253.0" layoutY="430.0" mnemonicParsing="false" onAction="#update" text="Update Brand">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Button>

        <Label fx:id="successLabel" alignment="CENTER" layoutX="15.0" layoutY="480.0" prefHeight="23.0" prefWidth="600.0" textAlignment="JUSTIFY">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Button layoutX="14.0" layoutY="540.0" mnemonicParsing="false" onAction="#backToBrand" text="&lt;----">
            <font>
                <Font size="24.0" />
            </font>
        </Button>
    </children>
</AnchorPane>