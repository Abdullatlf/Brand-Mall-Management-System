<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ProductController">
    <children>
        <Label layoutX="64.0" layoutY="14.0" text="Update Product Operation">
            <font>
                <Font name="Al Bayan Bold" size="36.0" />
            </font>
        </Label>

        <!-- TableView with Columns -->
        <TableView fx:id="productTableView" layoutX="64.0" layoutY="70.0" prefHeight="200.0" prefWidth="472.0">
            <columns>
                <TableColumn fx:id="productIdColumn" prefWidth="120.0" text="Product ID" />
                <TableColumn fx:id="nameColumn" prefWidth="160.0" text="Name" />
                <TableColumn fx:id="storeNoColumn" prefWidth="90.0" text="Store No" />
                <TableColumn fx:id="brandIdColumn" prefWidth="100.0" text="Brand ID" />
            </columns>
        </TableView>

        <Button layoutX="450.0" layoutY="280.0" mnemonicParsing="false" onAction="#refreshTable" text="Refresh">
            <font>
                <Font size="14.0" />
            </font>
        </Button>

        <Label layoutX="50.0" layoutY="320.0" text="Product ID : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <TextField fx:id="productIdTextField" layoutX="180.0" layoutY="322.0" prefWidth="150.0" />

        <Label layoutX="80.0" layoutY="360.0" text="Name : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <TextField fx:id="nameTextField" layoutX="180.0" layoutY="362.0" prefWidth="200.0" />

        <Label layoutX="70.0" layoutY="400.0" text="Brand : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <ComboBox fx:id="brandComboBox" layoutX="180.0" layoutY="402.0" prefWidth="200.0" />

        <Label layoutX="75.0" layoutY="440.0" text="Store : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <ComboBox fx:id="storeComboBox" layoutX="180.0" layoutY="442.0" prefWidth="250.0" />

        <Button layoutX="220.0" layoutY="490.0" mnemonicParsing="false" onAction="#update" text="Update Product">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Button>

        <Label fx:id="successLabel" alignment="CENTER" layoutX="15.0" layoutY="540.0" prefHeight="23.0" prefWidth="600.0" textAlignment="JUSTIFY">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Button layoutX="14.0" layoutY="580.0" mnemonicParsing="false" onAction="#backToProduct" text="&lt;----">
            <font>
                <Font size="24.0" />
            </font>
        </Button>
    </children>
</AnchorPane>