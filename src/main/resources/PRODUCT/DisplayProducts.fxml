<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ProductController">
    <children>
        <Label layoutX="86.0" layoutY="14.0" text="Show Product Operation">
            <font>
                <Font name="Al Bayan Bold" size="36.0" />
            </font>
        </Label>

        <!-- TableView with Columns -->
        <TableView fx:id="productTableView" layoutX="64.0" layoutY="88.0" prefHeight="350.0" prefWidth="472.0">
            <columns>
                <TableColumn fx:id="productIdColumn" prefWidth="120.0" text="Product ID" />
                <TableColumn fx:id="nameColumn" prefWidth="160.0" text="Name" />
                <TableColumn fx:id="storeNoColumn" prefWidth="90.0" text="Store No" />
                <TableColumn fx:id="brandIdColumn" prefWidth="100.0" text="Brand ID" />
            </columns>
        </TableView>

        <Button layoutX="14.0" layoutY="441.0" mnemonicParsing="false" onAction="#backToProduct" text="&lt;----">
            <font>
                <Font size="24.0" />
            </font>
        </Button>

        <Button layoutX="470.0" layoutY="441.0" mnemonicParsing="false" onAction="#refreshTable" text="Refresh">
            <font>
                <Font size="16.0" />
            </font>
        </Button>
    </children>
</AnchorPane>