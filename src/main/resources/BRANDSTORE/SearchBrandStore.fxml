<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.BrandStoreController">
    <children>
        <Label layoutX="35.0" layoutY="14.0" text="Search Brand Store Operation">
            <font>
                <Font name="Al Bayan Bold" size="36.0" />
            </font>
        </Label>
        <Label layoutX="90.0" layoutY="150.0" text="Store Number : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <Label layoutX="120.0" layoutY="190.0" text="Brand ID : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <TextField fx:id="storeNoTextField" layoutX="250.0" layoutY="152.0" />
        <TextField fx:id="brandIdTextField" layoutX="250.0" layoutY="192.0" />
        <Button fx:id="button" layoutX="220.0" layoutY="235.0" mnemonicParsing="false" onAction="#search" text="Find Brand Store">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Button>
        <Label fx:id="successLabel" alignment="CENTER" layoutX="15.0" layoutY="283.0" prefHeight="23.0" prefWidth="600.0" textAlignment="JUSTIFY">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Button layoutX="14.0" layoutY="441.0" mnemonicParsing="false" onAction="#backToBrandStore" text="&lt;----">
            <font>
                <Font size="24.0" />
            </font>
        </Button>
        <Label fx:id="searchLabel" alignment="CENTER" layoutX="8.0" layoutY="75.0" prefHeight="60.0" prefWidth="600.0" textAlignment="CENTER">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
    </children>
</AnchorPane>