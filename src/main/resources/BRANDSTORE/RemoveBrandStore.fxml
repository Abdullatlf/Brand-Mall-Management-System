<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.BrandStoreController">
    <children>
        <Label layoutX="30.0" layoutY="14.0" text="Remove Brand Store Operation">
            <font>
                <Font name="Al Bayan Bold" size="36.0" />
            </font>
        </Label>

        <!-- TableView with Columns -->
        <TableView fx:id="storeTableView" layoutX="20.0" layoutY="75.0" prefHeight="280.0" prefWidth="660.0">
            <columns>
                <TableColumn fx:id="storeNoColumn" prefWidth="80.0" text="Store No" />
                <TableColumn fx:id="brandIdColumn" prefWidth="100.0" text="Brand ID" />
                <TableColumn fx:id="addressColumn" prefWidth="200.0" text="Address" />
                <TableColumn fx:id="managerIdColumn" prefWidth="130.0" text="Manager ID" />
                <TableColumn fx:id="mallIdColumn" prefWidth="148.0" text="Mall ID" />
            </columns>
        </TableView>

        <Button layoutX="590.0" layoutY="365.0" mnemonicParsing="false" onAction="#refreshTable" text="Refresh">
            <font>
                <Font size="14.0" />
            </font>
        </Button>

        <Label layoutX="75.0" layoutY="410.0" text="Store Number : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <TextField fx:id="storeNoTextField" layoutX="250.0" layoutY="412.0" prefWidth="150.0" />

        <Label layoutX="105.0" layoutY="450.0" text="Brand ID : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <TextField fx:id="brandIdTextField" layoutX="250.0" layoutY="452.0" prefWidth="150.0" />

        <Button layoutX="240.0" layoutY="500.0" mnemonicParsing="false" onAction="#remove" text="Remove Brand Store" style="-fx-background-color: #d32f2f; -fx-text-fill: white;">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Button>

        <Label fx:id="successLabel" alignment="CENTER" layoutX="0.0" layoutY="550.0" prefHeight="23.0" prefWidth="700.0" textAlignment="JUSTIFY">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Button layoutX="14.0" layoutY="590.0" mnemonicParsing="false" onAction="#backToBrandStore" text="&lt;----">
            <font>
                <Font size="24.0" />
            </font>
        </Button>
    </children>
</AnchorPane>