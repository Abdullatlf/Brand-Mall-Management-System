<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.BrandStoreController">
    <children>
        <Label layoutX="30.0" layoutY="14.0" text="Update Brand Store Operation">
            <font>
                <Font name="Al Bayan Bold" size="36.0" />
            </font>
        </Label>

        <!-- TableView with Columns -->
        <TableView fx:id="storeTableView" layoutX="20.0" layoutY="70.0" prefHeight="200.0" prefWidth="660.0">
            <columns>
                <TableColumn fx:id="storeNoColumn" prefWidth="80.0" text="Store No" />
                <TableColumn fx:id="brandIdColumn" prefWidth="100.0" text="Brand ID" />
                <TableColumn fx:id="addressColumn" prefWidth="200.0" text="Address" />
                <TableColumn fx:id="managerIdColumn" prefWidth="130.0" text="Manager ID" />
                <TableColumn fx:id="mallIdColumn" prefWidth="148.0" text="Mall ID" />
            </columns>
        </TableView>

        <Button layoutX="590.0" layoutY="280.0" mnemonicParsing="false" onAction="#refreshTable" text="Refresh">
            <font>
                <Font size="14.0" />
            </font>
        </Button>

        <Label layoutX="15.0" layoutY="325.0" text="Store Number : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <TextField fx:id="storeNoTextField" layoutX="180.0" layoutY="327.0" prefWidth="150.0" />

        <Label layoutX="45.0" layoutY="365.0" text="Brand ID : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <TextField fx:id="brandIdTextField" layoutX="180.0" layoutY="367.0" prefWidth="150.0" />

        <Label layoutX="60.0" layoutY="405.0" text="Address : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <TextField fx:id="addressTextField" layoutX="180.0" layoutY="407.0" prefWidth="200.0" />

        <Label layoutX="45.0" layoutY="445.0" text="Manager : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <ComboBox fx:id="managerComboBox" layoutX="180.0" layoutY="447.0" prefWidth="200.0" />

        <Label layoutX="78.0" layoutY="485.0" text="Mall : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <ComboBox fx:id="mallComboBox" layoutX="180.0" layoutY="487.0" prefWidth="200.0" />

        <Button layoutX="420.0" layoutY="410.0" mnemonicParsing="false" onAction="#update" text="Update Store">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Button>

        <Label fx:id="successLabel" alignment="CENTER" layoutX="0.0" layoutY="545.0" prefHeight="23.0" prefWidth="700.0" textAlignment="JUSTIFY">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>

        <Button layoutX="14.0" layoutY="640.0" mnemonicParsing="false" onAction="#backToBrandStore" text="&lt;----">
            <font>
                <Font size="24.0" />
            </font>
        </Button>
    </children>
</AnchorPane>