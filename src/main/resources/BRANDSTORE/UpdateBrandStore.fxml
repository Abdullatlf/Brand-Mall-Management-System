<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.BrandStoreController">
    <children>
        <Label layoutX="30.0" layoutY="14.0" text="Update Brand Store Operation">
            <font>
                <Font name="Al Bayan Bold" size="36.0" />
            </font>
        </Label>
        <Label layoutX="15.0" layoutY="245.0" text="Store Number : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <Label layoutX="45.0" layoutY="285.0" text="Brand ID : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <Label layoutX="60.0" layoutY="325.0" text="Address : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <Label layoutX="45.0" layoutY="365.0" text="Manager : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <Label layoutX="78.0" layoutY="405.0" text="Mall : ">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <TextField fx:id="storeNoTextField" layoutX="170.0" layoutY="247.0" prefWidth="150.0" />
        <TextField fx:id="brandIdTextField" layoutX="170.0" layoutY="287.0" prefWidth="150.0" />
        <TextField fx:id="addressTextField" layoutX="170.0" layoutY="327.0" prefWidth="150.0" />
        <ComboBox fx:id="managerComboBox" layoutX="170.0" layoutY="367.0" prefWidth="150.0" />
        <ComboBox fx:id="mallComboBox" layoutX="170.0" layoutY="407.0" prefWidth="150.0" />
        <Button fx:id="button" layoutX="360.0" layoutY="320.0" mnemonicParsing="false" onAction="#update" text="Update Store">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Button>
        <Label fx:id="successLabel" alignment="CENTER" layoutX="15.0" layoutY="464.0" prefHeight="23.0" prefWidth="600.0" textAlignment="JUSTIFY">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <Button layoutX="14.0" layoutY="441.0" mnemonicParsing="false" onAction="#backToBrandStore" text="&lt;----">
            <font>
                <Font size="24.0" />
            </font>
        </Button>
        <ListView fx:id="storeListView" layoutX="20.0" layoutY="70.0" prefHeight="160.0" prefWidth="560.0" />
    </children>
</AnchorPane>